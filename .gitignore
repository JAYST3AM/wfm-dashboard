__pycache__/
*.pyc
secrets.json
data/*
!data/.gitkeep
scripts/trader/
static/hi/
tools/preview_frames/

# regenerated from the local save (personal progress) - never commit
static/collection_log.json

# the collection page's icon cache (copies of the public CDN images, built by
# scripts/icon_cache.py) - derived data, never commit
static/colimg/

# generated stores that carry HIS account state (built by the scripts under scripts/ on install):
# relics_panel.py -> relic ownership + drop info, mastery.py -> mastery queue, progress.py -> sessions
static/relics_panel.json
static/mastery.json
static/progress.json

# fetched icon sources: the sprite (static/icons/phosphor.svg) is the shipped artifact;
# tools/build_icons.py --fetch can re-download these from the pinned name list
static/icons/src/

# the one-click app build output (built by tools/build_app.py; ships via Releases, not git)
dist/
build/

# chat relay local state (wrangler scratch)
chat-relay/.wrangler/
chat-relay/node_modules/
